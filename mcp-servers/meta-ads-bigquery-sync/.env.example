# Same Meta System User token as mcp-servers/meta-ads-mcp-server
META_ACCESS_TOKEN=
# One or more ad account IDs, comma-separated (with or without "act_"), e.g.
# META_AD_ACCOUNT_IDS=1004877592162559,1457520352339170
META_AD_ACCOUNT_IDS=
GRAPH_API_VERSION=v21.0

# GCP Service Account with "BigQuery Data Editor" + "BigQuery Job User" on
# the target dataset/project. Copy client_email and private_key straight out
# of the downloaded JSON key file.
GCP_PROJECT_ID=
GCP_CLIENT_EMAIL=
# Paste the full PEM as one line, keeping the \n sequences literal
# (that's how they already appear inside the JSON key file's "private_key" field).
GCP_PRIVATE_KEY=

# BigQuery destination (must match sql/schema.sql)
BQ_DATASET=meta_ads
BQ_TABLE=insights_daily

# Optional: required by the deployed Worker's manual /sync endpoint, not by
# the local backfill script
SYNC_SHARED_SECRET=
