# System User access token generated in Business Settings > Users > System Users
# Required scopes: ads_management, ads_read, business_management, pages_show_list,
# pages_read_engagement, read_insights
META_ACCESS_TOKEN=

# Ad account ID, without the "act_" prefix (e.g. 123456789012345)
META_AD_ACCOUNT_ID=

# Optional: override the Graph API version pinned in src/constants.ts
GRAPH_API_VERSION=v21.0
