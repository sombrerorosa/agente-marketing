# OAuth2 client (Desktop app type) created in the Google Cloud project that
# holds your Google Ads API access. Settings icon in Google Ads > API Center
# will have walked you to this project, or create one directly in
# console.cloud.google.com > APIs & Services > Credentials.
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=

# Long-lived refresh token for that OAuth client, generated once against the
# Google account that has access to the ad account below (see README.md).
GOOGLE_ADS_REFRESH_TOKEN=

# Target ad account's Customer ID, digits only (dashes are stripped either
# way), e.g. 1234567890. Use google_ads_list_accessible_customers to find it
# if you're not sure.
GOOGLE_ADS_CUSTOMER_ID=

# Only required if GOOGLE_ADS_CUSTOMER_ID is a client account managed through
# an MCC (manager) account and your OAuth user logs in at the MCC level.
# Digits only, no dashes. Omit if you authenticate directly against the
# target account.
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# Legacy developer token. Google retired the developer token as the thing
# that gates API access (access level now follows the Cloud project your
# OAuth client belongs to — see README.md), but the API still accepts the
# header, so set it if you have one from before the change. Safe to leave
# blank otherwise.
GOOGLE_ADS_DEVELOPER_TOKEN=

# Optional: override the API version pinned in src/constants.ts. Google ships
# a new major version roughly every 3 months and sunsets old ones about a
# year later — check https://developers.google.com/google-ads/api/docs/sunset-dates
# before you rely on the default for long.
GOOGLE_ADS_API_VERSION=v25
